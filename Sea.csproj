<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- VS 1.22 runs on .NET 10. Building with the .NET 8 SDK works as long as we compile
         against the installed .NET 10 runtime assemblies instead of the .NET 8 reference pack. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Sea</AssemblyName>
    <RootNamespace>Sea</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\mod\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultItems>false</EnableDefaultItems>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(APPDATA)\Vintagestory</VintageStoryPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Compile against the game's own .NET runtime (10.x) so the game DLLs' references line up. -->
  <PropertyGroup>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NetCoreRuntimeDir>$([System.IO.Directory]::GetDirectories('$(NetCoreRoot)shared\Microsoft.NETCore.App', '10.*')[0])</NetCoreRuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(NetCoreRuntimeDir)\System.*.dll" Exclude="$(NetCoreRuntimeDir)\System.Private.*.dll;$(NetCoreRuntimeDir)\System.IO.Compression.Native.dll" Private="false" />
    <Reference Include="$(NetCoreRuntimeDir)\System.Private.CoreLib.dll" Private="false" />
    <Reference Include="$(NetCoreRuntimeDir)\netstandard.dll" Private="false" />
    <Reference Include="$(NetCoreRuntimeDir)\mscorlib.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryPath)\Mods\VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="protobuf-net"><HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VintageStoryPath)\Lib\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OpenTK.Graphics"><HintPath>$(VintageStoryPath)\Lib\OpenTK.Graphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OpenTK.Mathematics"><HintPath>$(VintageStoryPath)\Lib\OpenTK.Mathematics.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release build also produces a ready-to-install zip in .\release, named with the version from modinfo.json
       (release\sea-<version>.zip). Never deletes or overwrites a release snapshot. -->
  <PropertyGroup>
    <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\modinfo.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>
  </PropertyGroup>
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(ModVersion)' == ''" Text="No version found in modinfo.json" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\release" />
    <Error Text="Package already exists. Preserve release snapshots: choose a new version or an explicit PackageFile." Condition="'$(PackageFile)' == '' and Exists('$(MSBuildProjectDirectory)\release\sea-$(ModVersion).zip')" />
    <PropertyGroup><PackageFile Condition="'$(PackageFile)' == ''">$(MSBuildProjectDirectory)\release\sea-$(ModVersion).zip</PackageFile></PropertyGroup>
    <ZipDirectory SourceDirectory="$(OutputPath)" DestinationFile="$(PackageFile)" Overwrite="false" />
  </Target>

</Project>
